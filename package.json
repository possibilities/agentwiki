{
  "name": "agentwiki",
  "version": "0.1.0",
  "description": "Agent-first document store: a plain-file vault, an embedded search index, and versioned immutable artifacts",
  "private": true,
  "type": "module",
  "bin": {
    "agentwiki": "./src/main.ts"
  },
  "engines": {
    "bun": "1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write src test",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/bun": "1.3.14",
    "@types/markdown-it": "^14.1.2",
    "bun-types": "1.3.14",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "markdown-it": "^15.0.0",
    "yaml": "^2.9.0"
  }
}
